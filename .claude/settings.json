{
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/supervisor-context-gauge.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-cd-into-worktree.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/supervisor-ci-guard.sh",
            "timeout": 90
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Write(//Users/moncefnaji/code/github.com/mrboard.worktrees/supervisor/**)",
      "Edit(//Users/moncefnaji/code/github.com/mrboard.worktrees/supervisor/**)",
      "Write(//Users/moncefnaji/code/github.com/mrboard.worktrees/briefs/**)",
      "Edit(//Users/moncefnaji/code/github.com/mrboard.worktrees/briefs/**)"
    ]
  }
}
