# Fleet configuration, read by every script in .claude/scripts and by the hooks.
# An environment variable of the same name wins over this file. Everything has a default; uncomment what differs.

# Tracker backend: github (Issues; native sub-issues and dependencies) or linear.
FLEET_TRACKER=github

# --- Linear only ---
#LINEAR_TEAM=ENG                  # the team key (required for linear)
#LINEAR_PROJECT="My project"      # optional: new issues are filed in this project
# The API key: export LINEAR_API_KEY, or write it to ~/.config/agents-dev-fleet/linear-api-key (chmod 600).

# --- Layout (defaults shown) ---
#FLEET_DEFAULT_BRANCH=main        # default: origin/HEAD
#FLEET_REPO=owner/name            # default: asked of `gh repo view`
#FLEET_WT_ROOT=/path/to/project.worktrees   # default: <checkout>.worktrees beside the checkout
#FLEET_SUPERVISOR_DIR=...         # ledger, user log, watcher pids (default: <wt root>/supervisor)

# --- CI the supervisor owns ---
FLEET_CI_WORKFLOWS="Check"        # workflow names whose latest run on the default branch must be green
FLEET_RELEASE_WORKFLOW="Release on merge" # a workflow a green CI push must trigger (e.g. Release); empty = none

# --- Merging ---
#FLEET_REVIEW_BOT=""              # login regex of a review bot (e.g. "greptile|coderabbit"): land.sh refuses
                                  # a merge while one of its comment threads has no reply
